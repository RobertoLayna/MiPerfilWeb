---
const projects = [
  {
    name: "El Ganador MX",
    role: "Fundador & Desarrollador",
    description: "Plataforma de rifas online con sorteos verificados, sistema de boletos, verificación de resultados y pagos integrados. +180 eventos entregados.",
    stack: ["Next.js", "Supabase", "PostgreSQL"],
    link: "https://ganadores.nopalsoft.net/",
    delay: "0",
  },
  {
    name: "HereHere",
    role: "Fundador & Desarrollador",
    description: "Control de asistencia biométrico con reconocimiento facial en tiempo real. Dashboard, gestión de colaboradores, dispositivos, horarios y suscripciones.",
    stack: ["React", "Flutter", "Python", "Docker", "Redis", "PostgreSQL", "Microservicios"],
    link: "https://h-here.com/",
    delay: "120",
  },
  {
    name: "barbarOS",
    role: "Fundador & Desarrollador",
    description: "Plataforma para administrar barberías: gestión de citas, barberos, clientes, inventario y pagos. App web con backend en microservicios.",
    stack: ["React", "NestJS", "PostgreSQL", "Docker"],
    link: "#",
    delay: "240",
  },
  {
    name: "weeldone",
    role: "Fundador & Desarrollador",
    description: "Hub de servicios de transporte con monitoreo en tiempo real. Tracking GPS, asignación de viajes, notificaciones y panel de control. (En desarrollo)",
    stack: ["React", "Node.js", "Docker", "WebSockets", "Redis", "PostgreSQL"],
    link: "#",
    delay: "360",
  },
];
---

<section class="projects" id="projects">
  <div class="container">
    <p class="section-label reveal" data-reveal-delay="0" data-i18n="projects.label">Proyectos</p>
    <h2 class="section-title reveal" data-reveal-delay="80" data-i18n="projects.title">Lo que construí</h2>
    <div class="projects-grid">
      {projects.map((proj, idx) => (
        <div class="project-card reveal" data-reveal-delay={proj.delay}>
          <h3>{proj.name}</h3>
          <p class="project-role" data-i18n={`projects.${idx + 1}.role`}>{proj.role}</p>
          <p data-i18n={`projects.${idx + 1}.desc`}>{proj.description}</p>
          <div class="project-stack">
            {proj.stack.map((tech, i) => (
              <>
                {i > 0 && <span class="stack-sep">•</span>}
                <span>{tech}</span>
              </>
            ))}
          </div>
          <a href={proj.link} class="project-link" data-i18n="projects.link">&rarr; Ver proyecto</a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.projects {
  padding: var(--section-y-desktop) 0;
  border-top: 1px solid var(--border-soft);
}
.projects-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-6);
  margin-top: var(--space-8);
}
.project-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: var(--space-6);
  transition: transform 0.3s var(--ease-standard), box-shadow 0.3s var(--ease-standard), border-color 0.25s var(--ease-standard);
}
.project-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--elev-raised);
  border-color: var(--accent);
}
.project-card h3 {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  font-weight: 700;
  line-height: var(--leading-tight);
  letter-spacing: -0.01em;
  color: var(--fg);
}
.project-card .project-role {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 510;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-top: var(--space-2);
}
.project-card p {
  font-size: var(--text-base);
  color: var(--fg-2);
  margin-top: var(--space-3);
  max-width: 55ch;
}
.project-card .project-stack {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-4);
}
.project-card .project-stack span {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 510;
  color: var(--muted);
  letter-spacing: 0.02em;
}
.project-card .project-link {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  font-weight: 510;
  color: var(--fg-2);
  text-decoration: underline;
  text-underline-offset: 3px;
  letter-spacing: 0.02em;
  margin-top: var(--space-4);
  transition: color var(--motion-fast) var(--ease-standard);
}
.project-card .project-link:hover { color: var(--accent); }

@media (max-width: 768px) {
  .projects-grid { grid-template-columns: 1fr; }
}
</style>
