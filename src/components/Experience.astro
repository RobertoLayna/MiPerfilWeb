---
const experiences = [
  {
    title: "Glyde & Glyde Unity",
    role: "Desarrollador Full Stack",
    description: "Implementación de chats con IA que entrevistan talento, asistiendo el proceso de reclutamiento con agentes conversacionales inteligentes.",
    tags: ["IA", "Chats", "Reclutamiento", "LLMs"],
    delay: "0",
  },
  {
    title: "USA Transfers",
    role: "Desarrollador de Sistemas",
    description: "Desarrollo de sistemas de transporte turístico, torneos de golf, control de unidades, taller mecánico y logística operativa.",
    tags: ["Transporte", "Golf", "Logística", "Operaciones"],
    delay: "120",
  },
  {
    title: "UPQROO — Universidad Politécnica de Quintana Roo",
    role: "Docente Universitario",
    description: "Impartí materias de Algoritmos, Programación Orientada a Objetos y Aplicaciones Móviles en la UPQROO, Cancún.",
    tags: ["Algoritmos", "POO", "Apps Móviles", "Docencia"],
    delay: "240",
  },
];
---

<section class="experience" id="experience">
  <div class="container">
    <p class="section-label reveal" data-reveal-delay="0">Experiencia</p>
    <h2 class="section-title reveal" data-reveal-delay="80">Donde he colaborado</h2>
    <div class="experience-grid">
      {experiences.map((exp) => (
        <div class="experience-card reveal" data-reveal-delay={exp.delay}>
          <h3>{exp.title}</h3>
          <p class="exp-role">{exp.role}</p>
          <p>{exp.description}</p>
          <div class="exp-tags">
            {exp.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.experience {
  padding: var(--section-y-desktop) 0;
  border-top: 1px solid var(--border-soft);
}
.experience-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-6);
  margin-top: var(--space-8);
}
.experience-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: var(--space-6);
  transition: transform 0.3s var(--ease-standard), box-shadow 0.3s var(--ease-standard), border-color 0.25s var(--ease-standard);
}
.experience-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--elev-raised);
  border-color: var(--accent);
}
.experience-card h3 {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  font-weight: 700;
  line-height: var(--leading-tight);
  letter-spacing: -0.01em;
  color: var(--fg);
}
.experience-card .exp-role {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 510;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-top: var(--space-2);
}
.experience-card p {
  font-size: var(--text-base);
  color: var(--fg-2);
  margin-top: var(--space-3);
  max-width: 55ch;
}
.exp-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-4);
}
.exp-tags span {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 510;
  color: var(--accent);
  background: var(--surface-warm);
  border: 1px solid var(--border-soft);
  border-radius: var(--radius-sm);
  padding: var(--space-1) var(--space-3);
  letter-spacing: 0.02em;
}

@media (max-width: 960px) {
  .experience-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
  .experience-grid { grid-template-columns: 1fr; }
}
</style>
