---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import LangSwitcher from "../components/LangSwitcher.astro";
import { translations } from "../i18n/translations.js";
const site = "https://roberto.nopalsoft.net";
const metaDesc = "Roberto Robles Layna — Full Stack Developer con 8+ años de experiencia. Especializado en Vue, React, Next.js, NestJS, Python, Flutter y arquitecturas cloud escalables.";
const canonical = site + "/";
const translationsJSON = JSON.stringify(translations);
const schemaJSON = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Roberto Robles Layna",
  "jobTitle": "Full Stack Developer",
  "url": canonical,
  "sameAs": [
    "https://github.com/RobertoLayna",
    "https://www.linkedin.com/in/roberto-robles-layna/"
  ],
  "image": site + "/avatar.png",
});
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Roberto Robles Layna — Desarrollador Full Stack</title>
  <meta name="description" content={metaDesc}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content="Roberto Robles Layna — Full Stack Developer">
  <meta property="og:description" content={metaDesc}>
  <meta property="og:image" content={site + "/avatar.png"}>

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Roberto Robles Layna — Full Stack Developer">
  <meta name="twitter:description" content={metaDesc}>
  <meta name="twitter:image" content={site + "/avatar.png"}>

  <script type="application/ld+json" set:html={schemaJSON}></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preload" href="/avatar.webp" as="image" fetchpriority="high">
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,510;0,14..32,590;0,14..32,700&family=JetBrains+Mono:ital,wght@0,400;0,510;0,590&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,510;0,14..32,590;0,14..32,700&family=JetBrains+Mono:ital,wght@0,400;0,510;0,590&display=swap" rel="stylesheet"></noscript>
</head>
<body>
  <Nav>
    <LangSwitcher slot="actions" />
  </Nav>
  <main>
    <slot />
  </main>
  <Footer />
  <script define:vars={{ translations }}>
    window.__TRANSLATIONS__ = translations;
    (function () {
      if (window.__i18nBooted) return;
      window.__i18nBooted = true;

      const dict = window.__TRANSLATIONS__;
      const DEFAULT = "es";
      const STORAGE_KEY = "lang";

      function getLang() {
        try {
          return localStorage.getItem(STORAGE_KEY) || DEFAULT;
        } catch (_) {
          return DEFAULT;
        }
      }

      function apply(lang) {
        document.querySelectorAll("[data-i18n]").forEach(function (el) {
          var key = el.getAttribute("data-i18n");
          var entry = dict[key];
          if (!entry) return;
          if (!el.hasAttribute("data-i18n-orig")) {
            el.setAttribute("data-i18n-orig", el.textContent);
          }
          el.textContent = lang === DEFAULT
            ? el.getAttribute("data-i18n-orig")
            : (entry[lang] || entry[DEFAULT] || el.getAttribute("data-i18n-orig"));
        });

        document.querySelectorAll("[data-i18n-html]").forEach(function (el) {
          var key = el.getAttribute("data-i18n-html");
          var entry = dict[key];
          if (!entry) return;
          if (!el.hasAttribute("data-i18n-html-orig")) {
            el.setAttribute("data-i18n-html-orig", el.innerHTML);
          }
          el.innerHTML = lang === DEFAULT
            ? el.getAttribute("data-i18n-html-orig")
            : (entry[lang] || entry[DEFAULT] || el.getAttribute("data-i18n-html-orig"));
        });

        document.documentElement.lang = lang;

        var titleEntry = dict["page.title"];
        if (titleEntry) {
          document.title = titleEntry[lang] || titleEntry[DEFAULT] || document.title;
        }
      }

      function typeAnimate(el, newText, callback) {
        var oldText = el.textContent;
        var i = oldText.length;
        var maxLen = Math.max(oldText.length, newText.length);
        var DELETE_MS = maxLen > 120 ? 5 : 8;
        var TYPE_MS = maxLen > 200 ? 10 : maxLen > 100 ? 16 : 22;

        function erase() {
          if (i <= 0) {
            var j = 0;
            function typeChar() {
              if (j <= newText.length) {
                el.textContent = newText.slice(0, j);
                j++;
                setTimeout(typeChar, TYPE_MS);
              } else if (callback) {
                callback();
              }
            }
            typeChar();
            return;
          }
          el.textContent = oldText.slice(0, i - 1);
          i--;
          setTimeout(erase, DELETE_MS);
        }
        erase();
      }

      var typing = false;

      window.switchLang = function (lang) {
        if (typing) return;
        var btn = document.getElementById("langToggle");
        if (btn) btn.disabled = true;
        try { localStorage.setItem(STORAGE_KEY, lang); } catch (_) {}

        var items = [];
        document.querySelectorAll("[data-i18n]").forEach(function (el) {
          var key = el.getAttribute("data-i18n");
          var entry = dict[key];
          if (!entry) return;
          if (!el.hasAttribute("data-i18n-orig")) {
            el.setAttribute("data-i18n-orig", el.textContent);
          }
          var next = lang === DEFAULT
            ? el.getAttribute("data-i18n-orig")
            : (entry[lang] || entry[DEFAULT] || el.getAttribute("data-i18n-orig"));
          if (el.textContent === next) return;
          items.push({ el: el, text: next });
        });

        typing = true;
        var remaining = items.length;

        function oneDone() {
          remaining--;
          if (remaining > 0) return;

          document.querySelectorAll("[data-i18n-html]").forEach(function (el) {
            var key = el.getAttribute("data-i18n-html");
            var entry = dict[key];
            if (!entry) return;
            if (!el.hasAttribute("data-i18n-html-orig")) {
              el.setAttribute("data-i18n-html-orig", el.innerHTML);
            }
            el.innerHTML = lang === DEFAULT
              ? el.getAttribute("data-i18n-html-orig")
              : (entry[lang] || entry[DEFAULT] || el.getAttribute("data-i18n-html-orig"));
          });

          document.documentElement.lang = lang;
          var titleEntry = dict["page.title"];
          if (titleEntry) {
            document.title = titleEntry[lang] || titleEntry[DEFAULT] || document.title;
          }
          typing = false;
          if (btn) btn.disabled = false;
        }

        if (remaining === 0) {
          oneDone();
          return;
        }

        for (var k = 0; k < items.length; k++) {
          typeAnimate(items[k].el, items[k].text, oneDone);
        }
      };

      var saved = getLang();
      document.documentElement.lang = saved;
      if (saved !== DEFAULT) {
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", function () { apply(saved); });
        } else {
          apply(saved);
        }
      }
    })();
  </script>
</body>
</html>

<style is:global>
:root {
  --bg: #fbf9ff;
  --surface: #ffffff;
  --surface-warm: #f1ecff;
  --fg: #1d1b2a;
  --fg-2: #4f4863;
  --muted: #5f5773;
  --meta: #6d4aff;
  --border: #ded7f0;
  --border-soft: #eee9f8;
  --accent: #6d4aff;
  --accent-on: #ffffff;
  --accent-hover: color-mix(in oklab, var(--accent), black 8%);
  --accent-active: color-mix(in oklab, var(--accent), black 14%);
  --success: #22a06b;
  --warn: #e6a700;
  --danger: #e5484d;
  --font-display: Inter, system-ui, sans-serif;
  --font-body: Inter, system-ui, sans-serif;
  --font-mono: "JetBrains Mono", "Roboto Mono", ui-monospace, Menlo, monospace;
  --text-xs: 12px;
  --text-sm: 14px;
  --text-base: 16px;
  --text-lg: 18px;
  --text-xl: 24px;
  --text-2xl: 34px;
  --text-3xl: 50px;
  --text-4xl: 70px;
  --leading-body: 1.55;
  --leading-tight: 1.05;
  --tracking-display: -0.025em;
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;
  --space-8: 32px;
  --space-12: 48px;
  --section-y-desktop: 96px;
  --section-y-tablet: 68px;
  --section-y-phone: 48px;
  --radius-sm: 10px;
  --radius-md: 16px;
  --radius-lg: 24px;
  --radius-pill: 9999px;
  --elev-flat: none;
  --elev-ring: 0 0 0 1px var(--border);
  --elev-raised: 0 20px 48px rgba(45, 36, 85, 0.12);
  --focus-ring: 0 0 0 4px rgba(109, 74, 255, 0.24);
  --motion-fast: 150ms;
  --motion-base: 230ms;
  --ease-standard: cubic-bezier(0.22, 1, 0.36, 1);
  --container-max: 1160px;
  --container-gutter-desktop: 36px;
  --container-gutter-tablet: 24px;
  --container-gutter-phone: 16px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  font-family: var(--font-body);
  font-size: var(--text-base);
  line-height: var(--leading-body);
  color: var(--fg);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
}

.container {
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 0 var(--container-gutter-desktop);
}

/* ── Buttons ─────────────────────────────── */

.btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-family: var(--font-body);
  font-size: var(--text-base);
  font-weight: 590;
  letter-spacing: 0.02em;
  padding: var(--space-3) var(--space-6);
  border: none;
  border-radius: var(--radius-md);
  cursor: pointer;
  text-decoration: none;
  transition: background var(--motion-fast) var(--ease-standard);
}
.btn-primary {
  background: var(--accent);
  color: var(--accent-on);
}
.btn-primary:hover { background: var(--accent-hover); }
.btn-primary:active { background: var(--accent-active); }
.btn-primary:focus-visible { box-shadow: var(--focus-ring); }
.btn-secondary {
  background: var(--surface);
  color: var(--fg);
  box-shadow: var(--elev-ring);
}
.btn-secondary:hover { background: var(--surface-warm); }
.btn-secondary:focus-visible { box-shadow: var(--focus-ring); }

/* ── Section labels & titles ──────────────── */

.section-label {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 510;
  color: var(--fg-2);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}
.section-title {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: 700;
  line-height: var(--leading-tight);
  letter-spacing: -0.015em;
  color: var(--fg);
  margin-top: var(--space-2);
}

/* ── Animations ─────────────────────────────── */

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(28px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes dotPulse {
  0%, 100% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--success), transparent 70%); }
  50%      { box-shadow: 0 0 0 8px color-mix(in oklab, var(--success), transparent 100%); }
}
@keyframes avatarGlow {
  0%, 100% { box-shadow: 0 0 30px color-mix(in oklab, var(--accent), transparent 88%); }
  50%      { box-shadow: 0 0 60px color-mix(in oklab, var(--accent), transparent 78%); }
}
@keyframes marqueeScroll {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.reveal {
  opacity: 0;
  transform: translateY(28px);
}

.reveal.revealed {
  animation: fadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

@media (prefers-reduced-motion: reduce) {
  .reveal { opacity: 1; transform: none; }
  .reveal.revealed { animation: none; }
  .availability-badge .dot { animation: none; }
  .hero-visual .avatar-wrapper.glow { animation: none; }
  .marquee-track { animation: none; }
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

/* ── Hero title accent (needed for i18n innerHTML swap) ── */
.hero h1 span {
  color: var(--accent);
}

/* ── Responsive ─────────────────────────────── */

@media (max-width: 768px) {
  .container { padding: 0 var(--container-gutter-tablet); }
  .section-title { font-size: var(--text-xl); }
}

@media (max-width: 480px) {
  .container { padding: 0 var(--container-gutter-phone); }
}
</style>
